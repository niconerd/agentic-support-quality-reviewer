OPENAI_API_KEY=
REVIEWER_MODEL=gpt-6-luna
REVIEWER_DB=data/reviewer.sqlite3
# Standard USD per 1M tokens, verified 2026-10-02:
# https://developers.openai.com/api/docs/models/gpt-6-luna
REVIEWER_INPUT_PRICE=0.10
REVIEWER_CACHED_INPUT_PRICE=0.01
REVIEWER_OUTPUT_PRICE=0.50
# Base estimate only. Cache writes ($0.125/1M), long-context uplifts,
# regional premiums, and alternate service-tier rates are not modeled.
# Update these prices if you choose a different model.

# Pace sequential evaluation; API 429 cooldowns are retried automatically.
REVIEWER_CASE_DELAY_SECONDS=5
REVIEWER_CHECK_DELAY_SECONDS=1
